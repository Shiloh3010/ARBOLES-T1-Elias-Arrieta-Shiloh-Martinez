# Nodo del árbol
class Node:
    def __init__(self, valor):
        self.val = valor
        self.padre = None


# Nodo de la lista enlazada
# -------------------------------
class NodoLista:
    def __init__(self, nodo):
        self.nodo = nodo
        self.siguiente = None
# Árbol 
class Arbol:
    def __init__(self, raiz_valor):
        raiz = Node(raiz_valor)

        self.cabeza = NodoLista(raiz)  # única lista
        self.raiz = raiz

    # Insertar
    def insertar(self):
        valor = input("Valor del nodo: ")
        padre_valor = input("Valor del padre: ")

        padre = None
        actual = self.cabeza

        while actual:
            if actual.nodo.val == padre_valor:
                padre = actual.nodo
                break
            actual = actual.siguiente

        if padre is None:
            print("Padre no encontrado")
            return

        nuevo = Node(valor)
        nuevo.padre = padre

        nuevo_lista = NodoLista(nuevo)

        actual = self.cabeza
        while actual.siguiente:
            actual = actual.siguiente

        actual.siguiente = nuevo_lista

  
    # Peso
    def peso(self):
        contador = 0
        actual = self.cabeza

        while actual:
            contador += 1
            actual = actual.siguiente

        return contador

    # Orden
    def orden(self):
        max_hijos = 0
        actual = self.cabeza

        while actual:
            nodo = actual.nodo
            contador = 0

            aux = self.cabeza
            while aux:
                if aux.nodo.padre == nodo:
                    contador += 1
                aux = aux.siguiente

            if contador > max_hijos:
                max_hijos = contador

            actual = actual.siguiente

        return max_hijos

    # Altura
    # ---------------------------
    def altura(self):
        max_altura = 0
        actual = self.cabeza

        while actual:
            nodo = actual.nodo
            altura = 0

            while nodo:
                altura += 1
                nodo = nodo.padre

            if altura > max_altura:
                max_altura = altura

            actual = actual.siguiente

        return max_altura

# PROGRAMA PRINCIPAL
def main():
    raiz = input("Ingrese la raíz: ")
    arbol = Arbol(raiz)

    while True:
        print("\n1. Insertar")
        print("2. Peso")
        print("3. Orden")
        print("4. Altura")
        print("5. Salir")

        op = input("Opción: ")

        if op == "1":
            arbol.insertar()

        elif op == "2":
            print("Peso:", arbol.peso())

        elif op == "3":
            print("Orden:", arbol.orden())

        elif op == "4":
            print("Altura:", arbol.altura())

        elif op == "5":
            break

        else:
            print("Opción inválida")


main()
