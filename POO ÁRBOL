# Nodo del árbol
class Nodo:
    def __init__(self, valor):
        self.valor = valor
        self.padre = None



# Nodo de la lista enlazada
class NodoLista:
    def __init__(self, nodo):
        self.nodo = nodo
        self.siguiente = None


class Arbol:
    def __init__(self, valor_raiz):
        raiz = Nodo(valor_raiz)

        self.cabeza = NodoLista(raiz)  
        self.raiz = raiz

    # Insertar
    def insertar(self):
        valor = input("Ingresa el valor del nodo: ")
        padre_valor = input("Ingresa el valor del padre: ")

        padre = None
        actual = self.cabeza

        while actual:
            if actual.nodo.valor == padre_valor:
                padre = actual.nodo
                break
            actual = actual.siguiente

        if padre is None:
            print("Padre no encontrado")
            return

        nuevo = Nodo(valor)
        nuevo.padre = padre

        nuevo_lista = NodoLista(nuevo)

        actual = self.cabeza
        while actual.siguiente:
            actual = actual.siguiente

        actual.siguiente = nuevo_lista


    # Peso
    def peso(self):
        contador = 0
        actual = self.cabeza

        while actual:
            contador += 1
            actual = actual.siguiente

        return contador

 
    # Orden
    def orden(self):
        max_hijos = 0
        actual = self.cabeza

        while actual:
            nodo = actual.nodo
            contador = 0

            cabeza = self.cabeza
            while cabeza:
                if cabeza.nodo.padre == nodo:
                    contador += 1
                cabeza = cabeza.siguiente

            if contador > max_hijos:
                max_hijos = contador

            actual = actual.siguiente

        return max_hijos


    # Altura
    def altura(self):
        max_altura = 0
        actual = self.cabeza

        while actual:
            nodo = actual.nodo
            altura = 0

            while nodo:
                altura += 1
                nodo = nodo.padre

            if altura > max_altura:
                max_altura = altura

            actual = actual.siguiente

        return max_altura




raiz = input("Ingrese el valor de la raíz del arbol: ")
arbol = Arbol(raiz)

while True:
    while True:

        print("\n1. Insertar nodo al arbol")
        print("2. Calcular el peso del arbol")
        print("3. Calcular el orden del arbol")
        print("4. Calcular la altura del arbol")
        print("5. Salir del programa")

        opcion = input("Ingresa una opción: ")

        match opcion:

            case "1":
                arbol.insertar()

            case "2":
                print("Peso:", arbol.peso())

            case "3":
                print("Orden:", arbol.orden())

            case "4":
                print("Altura:", arbol.altura())

            case "5":
                break

            case _:
                print("Opción invalida")


